DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# Encrypts stored provider credentials. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Comma-separated allowed hosts.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Path of the Django admin (default admin/). Set a private value on a public deployment.
DJANGO_ADMIN_PATH=admin

# Clerk sign-in for the hosted Console. Leave blank for self-hosted local auth:
# the Console uses POST /api/auth/local/ (email + password, no verification) when
# VITE_SELF_HOSTED=true and VITE_CLERK_PUBLISHABLE_KEY is blank. API keys and
# guest sessions still work either way. Secret from https://dashboard.clerk.com/.
CLERK_API_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Canonical MCP resource URL for OAuth discovery; required on hosted deployments.
MCP_SERVER_URL=http://localhost:8000/api/mcp/
# Public domain-ownership token from the OpenAI plugin submission page.
OPENAI_APPS_CHALLENGE=

DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# ─── Database ────────────────────────────────────────────────────────────────
# Defaults match the docker compose postgres service.
# POSTGRES_DB=overbae
# POSTGRES_USER=overbae
# POSTGRES_PASSWORD=overbae
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432

# ─── Celery / Redis ──────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─── Required: model provider ────────────────────────────────────────────────
# The API refuses to start without OPENROUTER_API_KEY. It serves judges, evals,
# trace scoring and other routed model calls. Get a key at
# https://openrouter.ai/keys.
OPENROUTER_API_KEY=
JEV_REQUESTS_PER_MINUTE=1200
JEV_TOKENS_PER_SECOND=250000
# Optional. OPENAI_API_KEY serves the embedding_cosine evaluator.
OPENAI_API_KEY=

FRONTEND_URL=http://localhost:5173

# Optional. MCP analytics: the server sends $mcp_* events to this PostHog project.
# Empty disables it. Unset, hosted deployments (Clerk, not DEBUG) use the Overmind
# project's token from settings.py. Project token (phc_...) from PostHog project settings.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com

# ─── Stripe billing ─────────────────────────────────────────────────
# Set STRIPE_SECRET_KEY to inject remaining-credit billing (cloud). Leave it
# empty for OSS: usage is still metered and shown, with no remaining-credit cap.
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret from Stripe Dashboard → Developers → Webhooks.
# Endpoint: POST /api/billing/webhook/  (listen for invoice.paid).
STRIPE_WEBHOOK_SECRET=
# Pro plan recurring price id (defaults to the live Pro price if unset).
STRIPE_PRO_PRICE_ID=price_1TvfC1CgXbweROl8gtGzCSV6
# One Overmind Credit at $0.01, one-time. Top-up checkout quantity = credits bought.
# Sandbox value below (product prod_Uxk0NXK4DO91Sz); prod uses
# price_1TxoTvCgXbweROl8s9G4WsfI (product prod_UxjxGrapXS061n).
STRIPE_CREDIT_PRICE_ID=price_1TxoWdCjF8jVtWKgOWHw2oFE

# ─── AWS (optional — needed for Textract OCR and Comprehend PII) ─────
# AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── Optional overrides (defaults work out of the box with docker compose) ───
# SECRET_KEY=change-me-in-production
# DEBUG=false
# FRONTEND_URL=http://localhost:8000

# ─── Slack notifications ─────────────────────────────────────────────────────
# Set this to your Slack incoming webhook URL to get a message in your channel
# whenever a user submits feedback.
# SLACK_FEEDBACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ─── Required: training and serving ──────────────────────────────────────────
# The API refuses to start until HF_TOKEN, MODAL_TOKEN_ID, MODAL_TOKEN_SECRET,
# INFERENCE_API_URL, INFERENCE_API_KEY, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# and AWS_BUCKET_NAME are set.
# Hugging Face token for gated base models (https://huggingface.co/settings/tokens).
# Also add it to the Modal secret overmind-inference.
HF_TOKEN=

# Finetuning
BASETEN_API_KEY=
BASETEN_PROJECT=
FINETUNING_BACKEND=modal

# Modal tokens: https://modal.com/settings/tokens. INFERENCE_API_URL is printed
# by `modal deploy`; INFERENCE_API_KEY is a shared secret you choose and also set
# in the Modal secret overmind-inference. Set MODAL_ENVIRONMENT explicitly for training and deployment.
INFERENCE_API_URL=
INFERENCE_API_KEY=
MODAL_ENVIRONMENT=overmind-dev
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

TOGETHER_API_KEY=

# Fine-tuning checkpoint S3 archive (baseten/modal providers) — durable home
# for checkpoint.zip/job_logs.txt/metrics.json, see
# overbae/modal/register_model.py's sync_*_to_s3. Django reads these for
# presigned download URLs. Same keys must also be on the "overmind-inference"
# Modal secret for CloudBucketMount. Bucket name is hardcoded in
# register_model.py from MODAL_ENVIRONMENT (not read from this env at Modal
# deploy time). Unrelated to FileField storage (local unless the hosted
# buckets below are set).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=
AWS_REGION=eu-west-1

# Hosted opt-in: FileField / staticfiles S3. Unset = local MEDIA_ROOT / STATIC_ROOT.
# AWS_STORAGE_BUCKET_NAME=
# AWS_STATIC_BUCKET_NAME=
# When DJANGO_DEBUG is false, STATIC_URL defaults to https://static.overmindlab.ai/
# (ECS does not inject this). Set it to override; leave unset rather than empty.
# AWS_S3_CUSTOM_DOMAIN=

# ─── Grafana ─────────────────────────────────────────────────────────────────
# Admin password for the local Grafana instance (http://localhost:3001)
# Defaults to "admin" if unset — change for any shared environment
GRAFANA_ADMIN_PASSWORD=
# AWS SSO profile used by Grafana to query CloudWatch (defaults to administrator)
AWS_PROFILE=administrator
# Immutable image IDs approved for isolated Workshop scripts. Build docker/workshop
# and inspect the image ID before enabling the dedicated workshop-runner service.
WORKSHOP_RUNTIME_IMAGES=
