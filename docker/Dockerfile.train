# One training image definition for Modal and SageMaker.
# Modal's Image.from_dockerfile has no --target, so ARG STACK selects the stage
# and the last stage is the image. SageMaker builds with the same argument.
# No ENTRYPOINT: SageMaker sets ContainerEntrypoint, and an ENTRYPOINT would
# also start inside every Modal function that uses this image.
ARG STACK=u2026_10_7
ARG CUDA_BASE=nvidia/cuda:12.8.0-devel-ubuntu22.04
FROM ${CUDA_BASE} AS base

ENV DEBIAN_FRONTEND=noninteractive \
    HF_HOME=/tmp/hf_cache \
    HF_XET_HIGH_PERFORMANCE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/root:/workspace

# Jammy's own python3.11 is 3.11.0rc1 and has ensurepip disabled.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    ca-certificates \
    gnupg \
    software-properties-common \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3.11-venv \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python \
    && ln -sf /usr/bin/python3.11 /usr/local/bin/python3 \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python \
    && python -m pip install --upgrade pip \
    && rm -rf /var/lib/apt/lists/*

FROM base AS u2026_7
RUN python -m pip install --no-cache-dir "torch==2.7.0" --index-url https://download.pytorch.org/whl/cu128 \
    && python -m pip install --no-cache-dir \
    "unsloth[cu128-torch270]==2026.7.5" \
    "unsloth_zoo==2026.7.6" \
    "transformers>=5.2.0" \
    "datasets>=3.0.0" \
    "huggingface_hub>=0.27.0" \
    "sentencepiece" \
    "protobuf" \
    && python -m pip install --no-cache-dir --no-build-isolation \
    "torch==2.7.0" \
    "mamba-ssm>=2.2.0" \
    "causal-conv1d>=1.4.0" \
    && git clone --depth 1 --branch v1.10.0 https://github.com/huggingface/trl.git /opt/trl_src
ENV TRL_SRC=/opt/trl_src \
    UNSLOTH_IMAGE=u2026_7

FROM base AS torch210
RUN python -m pip install --no-cache-dir "torch==2.10.0" --index-url https://download.pytorch.org/whl/cu128 \
    && python -m pip install --no-cache-dir \
    "unsloth[cu128-torch2100]==2026.8.5" \
    "unsloth_zoo==2026.8.4" \
    "datasets>=3.0.0" \
    "huggingface_hub>=0.27.0" \
    "sentencepiece" \
    "protobuf" \
    && python -m pip install --no-cache-dir --no-build-isolation \
    "torch==2.10.0" \
    "mamba-ssm>=2.2.0" \
    "causal-conv1d>=1.4.0"

FROM torch210 AS u2026_8_tf510
RUN python -m pip install --no-cache-dir "transformers>=5.10.2" \
    && git clone --depth 1 --branch v1.10.0 https://github.com/huggingface/trl.git /opt/trl_src \
    && python -c "import torch, transformers; from torch.nn.functional import ScalingType; assert torch.__version__.startswith('2.10'), torch.__version__; assert tuple(int(x) for x in transformers.__version__.split('.')[:2]) >= (5, 10), transformers.__version__; print('u2026_8_tf510-ok', torch.__version__, transformers.__version__)" \
    && python -c "import mamba_ssm; print('mamba-ok')"
ENV TRL_SRC=/opt/trl_src \
    UNSLOTH_IMAGE=u2026_8_tf510

FROM torch210 AS u2026_8_tf515
RUN python -m pip install --no-cache-dir "transformers>=5.15.0" \
    && git clone --depth 1 --branch v1.10.0 https://github.com/huggingface/trl.git /opt/trl_src \
    && python -c "import torch, transformers; from torch.nn.functional import ScalingType; assert torch.__version__.startswith('2.10'), torch.__version__; assert tuple(int(x) for x in transformers.__version__.split('.')[:2]) >= (5, 15), transformers.__version__; print('u2026_8_tf515-ok', torch.__version__, transformers.__version__)" \
    && python -c "from transformers import MuseGlimmerForConditionalGeneration"
ENV TRL_SRC=/opt/trl_src \
    UNSLOTH_IMAGE=u2026_8_tf515

FROM torch210 AS u2026_8_gptoss
# Keep Unsloth's transformers pin. 5.10+ remaps MoE experts and drops the bnb-4bit weights.
# kernels 0.15+ crashes that transformers import.
RUN python -m pip install --no-cache-dir "kernels>=0.12.0,<0.15" \
    && git clone --depth 1 --branch v1.10.0 https://github.com/huggingface/trl.git /opt/trl_src \
    && python -c "import torch, transformers; from torch.nn.functional import ScalingType; assert torch.__version__.startswith('2.10'), torch.__version__; print('u2026_8_gptoss-ok', torch.__version__, transformers.__version__)" \
    && python -c "import kernels; print('kernels-ok')"
ENV TRL_SRC=/opt/trl_src \
    UNSLOTH_IMAGE=u2026_8_gptoss \
    UNSLOTH_COMPILE_DISABLE=1

FROM base AS u2026_8_18
RUN python -m pip install --no-cache-dir "torch==2.10.0" --index-url https://download.pytorch.org/whl/cu128 \
    && python -m pip install --no-cache-dir \
    "unsloth[cu128-torch2100]==2026.8.18" \
    "unsloth_zoo==2026.8.12" \
    "datasets>=3.0.0" \
    "huggingface_hub>=0.27.0" \
    "sentencepiece" \
    "protobuf" \
    && python -m pip install --no-cache-dir --no-build-isolation \
    "torch==2.10.0" \
    "mamba-ssm>=2.2.0" \
    "causal-conv1d>=1.4.0" \
    && python -m pip install --no-cache-dir "transformers>=5.10.2" \
    && git clone --depth 1 --branch v1.10.0 https://github.com/huggingface/trl.git /opt/trl_src \
    && python -c "import torch, transformers; from torch.nn.functional import ScalingType; assert torch.__version__.startswith('2.10'), torch.__version__; assert tuple(int(x) for x in transformers.__version__.split('.')[:2]) >= (5, 10), transformers.__version__; print('u2026_8_18-ok', torch.__version__, transformers.__version__)" \
    && python -c "import mamba_ssm; print('mamba-ok')"
ENV TRL_SRC=/opt/trl_src \
    UNSLOTH_IMAGE=u2026_8_18

FROM base AS u2026_9_2
RUN python -m pip install --no-cache-dir "torch==2.10.0" --index-url https://download.pytorch.org/whl/cu128 \
    && python -m pip install --no-cache-dir \
    "unsloth[cu128-torch2100]==2026.9.2" \
    "unsloth_zoo==2026.9.1" \
    "datasets>=3.0.0" \
    "huggingface_hub>=0.27.0" \
    "sentencepiece" \
    "protobuf" \
    && python -m pip install --no-cache-dir --no-build-isolation \
    "torch==2.10.0" \
    "mamba-ssm>=2.2.0" \
    "causal-conv1d>=1.4.0" \
    && python -m pip install --no-cache-dir "transformers>=5.10.2" \
    && git clone --depth 1 --branch v1.10.0 https://github.com/huggingface/trl.git /opt/trl_src \
    && python -c "import torch, transformers; from torch.nn.functional import ScalingType; assert torch.__version__.startswith('2.10'), torch.__version__; assert tuple(int(x) for x in transformers.__version__.split('.')[:2]) >= (5, 10), transformers.__version__; print('u2026_9_2-ok', torch.__version__, transformers.__version__)" \
    && python -c "import mamba_ssm; print('mamba-ok')"
ENV TRL_SRC=/opt/trl_src \
    UNSLOTH_IMAGE=u2026_9_2

FROM base AS u2026_10_7
RUN python -m pip install --no-cache-dir "torch==2.10.0" --index-url https://download.pytorch.org/whl/cu128 \
    && python -m pip install --no-cache-dir \
    "unsloth[cu128-torch2100]==2026.10.7" \
    "unsloth_zoo==2026.10.7" \
    "transformers==5.17.0" \
    "datasets>=3.0.0" \
    "huggingface_hub>=0.27.0" \
    "sentencepiece" \
    "protobuf" \
    && git clone --depth 1 --branch v1.10.0 https://github.com/huggingface/trl.git /opt/trl_src \
    && python -c "import torch, transformers; from torch.nn.functional import ScalingType; assert torch.__version__.startswith('2.10'), torch.__version__; assert tuple(int(x) for x in transformers.__version__.split('.')[:2]) >= (5, 17), transformers.__version__; print('u2026_10_7-ok', torch.__version__, transformers.__version__)"
ENV TRL_SRC=/opt/trl_src \
    UNSLOTH_IMAGE=u2026_10_7

FROM base AS u2026_10_3_decision
RUN python -m pip install --no-cache-dir "torch==2.10.0" "torchvision==0.25.0" --index-url https://download.pytorch.org/whl/cu128 \
    && python -m pip install --no-cache-dir \
    "unsloth==2026.10.3" \
    "unsloth_zoo==2026.10.3" \
    "transformers==5.17.0" \
    "trl==1.13.0" \
    "datasets==4.7.0" \
    "sentencepiece" \
    "protobuf" \
    "bitsandbytes==0.49.2"
ENV UNSLOTH_IMAGE=u2026_10_3_decision \
    UNSLOTH_DISABLE_STATISTICS=1 \
    UNSLOTH_COMPILE_DISABLE=1

FROM ${STACK} AS runtime
RUN python -m pip install --no-cache-dir "jsonschema==4.26.0" "boto3>=1.35.0"
WORKDIR /workspace
COPY modal_shared /root/modal_shared
COPY overbae/services/sft_assets /root/sft_assets
COPY overbae/sagemaker /workspace/overbae/sagemaker
ENV OVERMIND_SFT_ASSETS_DIR=/root/sft_assets
