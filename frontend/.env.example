# Copy to `.env.local` (gitignored) for local secrets.

# Local Console SDK dev only (localhost API): editable install in onboarding prompts.
# Ignored on staging and production builds. Restart Vite after changing.
# VITE_SDK_EDITABLE_PATH=/absolute/path/to/platform/overmind

# Git ref for staging and localhost prompts when editable path is not set (default: main).
# VITE_SDK_GIT_REF=main

VITE_LATEST_CLI_VERSION=0.1.55
