# `bun run dev` reads .env.development; staging and production builds read
# .env.staging / .env.production. Those files win over .env, so put local
# overrides in .env.development.local (gitignored), copied from this file.
VITE_API_BASE_URL=http://localhost:8000
# Self-hosted: set true and leave the Clerk key blank for email/password login
# (POST /api/auth/local/). Hosted Console keeps a publishable key and omits this.
VITE_SELF_HOSTED=true
VITE_CLERK_PUBLISHABLE_KEY=
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

VITE_FEATURE_DATASETS=true
VITE_FEATURE_EVALUATIONS=true
VITE_FEATURE_FINETUNING=true
VITE_FEATURE_INFERENCE=true
VITE_FEATURE_MCP=true

# Local API only: editable SDK install in onboarding prompts (otherwise PyPI).
# VITE_SDK_EDITABLE_PATH=/absolute/path/to/overmind/overmind
