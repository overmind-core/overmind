# Copy to .env. Vite reads it for `bun run dev` and `bun run build`.
VITE_API_BASE_URL=http://localhost:8000
VITE_CLERK_PUBLISHABLE_KEY=
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

VITE_FEATURE_DATASETS=true
VITE_FEATURE_EVALUATIONS=true
VITE_FEATURE_FINETUNING=true
VITE_FEATURE_INFERENCE=true
VITE_FEATURE_MCP=true

# Local API only: editable SDK install in onboarding prompts, else git ref (default main).
# VITE_SDK_EDITABLE_PATH=/absolute/path/to/overmind/overmind
# VITE_SDK_GIT_REF=main
