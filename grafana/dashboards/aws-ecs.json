  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "timepicker": {},
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "editable": true,
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "label": "Data source",
        "pluginId": "cloudwatch",
        "query": "cloudwatch",
        "refresh": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "current": {}
      },
      {
        "name": "region",
        "type": "custom",
        "label": "Region",
        "hide": 0,
        "query": "eu-west-1,us-east-1,us-west-2,eu-west-2",
        "current": {
          "selected": true,
          "text": "eu-west-1",
          "value": "eu-west-1"
        },
        "options": [
          {
            "selected": true,
            "text": "eu-west-1",
            "value": "eu-west-1"
          },
          {
            "selected": false,
            "text": "us-east-1",
            "value": "us-east-1"
          },
          {
            "selected": false,
            "text": "us-west-2",
            "value": "us-west-2"
          },
          {
            "selected": false,
            "text": "eu-west-2",
            "value": "eu-west-2"
          }
        ],
        "includeAll": false,
        "multi": false
      }
    ]
