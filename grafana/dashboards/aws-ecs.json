  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU Utilization % \u2014 all services",
      "description": "AWS/ECS CPUUtilization \u2014 average per service. Alarm threshold: 80%.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 60
              },
              {
                "color": "red",
                "value": 80
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource}"
          },
          "queryMode": "Metrics",
          "region": "${region}",
          "namespace": "AWS/ECS",
          "metricName": "CPUUtilization",
          "dimensions": {
            "ClusterName": "overmind-prod-cluster",
            "ServiceName": "overmind-prod-cluster-api"
          },
          "statistic": "Average",
          "period": "60",
          "matchExact": true,
          "id": "a"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource}"
          },
          "queryMode": "Metrics",
          "region": "${region}",
          "namespace": "AWS/ECS",
          "metricName": "CPUUtilization",
          "dimensions": {
            "ClusterName": "overmind-prod-cluster",
            "ServiceName": "overmind-prod-cluster-celery-worker"
          },
          "statistic": "Average",
          "period": "60",
          "matchExact": true,
          "id": "b"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource}"
          },
          "queryMode": "Metrics",
          "region": "${region}",
          "namespace": "AWS/ECS",
